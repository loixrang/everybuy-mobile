<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only: allow cleartext so the emulator (10.0.2.2) and physical devices
  (LAN IP of the development machine) can reach a local NestJS server over HTTP.
  This file replaces the main config for debug builds; release stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
